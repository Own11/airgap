APP_NAME=AirGap
APP_ENV=development
LOG_LEVEL=INFO

DATA_DIR=data
UPLOADS_DIR=data/uploads
CHROMA_DIR=data/chroma
SQLITE_PATH=data/airgap.sqlite3

# Minimal profile. Change these values without editing Python code.
WHISPER_MODEL=tiny
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
